# MongoDB Atlas (o único banco usado)
MONGODB_CONNECTION_STRING_ATLAS="mongodb+srv://usuario:senha@cluster.mongodb.net/"
MONGODB_DATABASE="movie-search"

# Anthropic (sugestão de filmes por palavras-chave)
ANTHROPIC_API_KEY="sk-ant-..."

# RapidAPI (magnet link ao cadastrar um favorito)
RAPIDAPI_API_KEY="sua-chave-api-rapidapi"

# OpenSubtitles (legenda ao cadastrar um favorito)
OPEN_SUBTITLES_API_KEY="sua-chave-api-open-subtitles"

# AWS S3 (imagens principais). Só a feature main-images precisa destas.
AWS_ACCESS_KEY_ID="sua-chave-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="sua-chave-aws-secret-access-key"
AWS_REGION="us-east-2"
S3_BUCKET="themoviesearch"

# Opcionais
LOG_LEVEL="INFO"
IMDB_HEADLESS="1"
